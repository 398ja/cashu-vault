# PostgreSQL
POSTGRES_DB=cashu_vault
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Spring Datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://cashu-vault-db:5432/cashu_vault
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=changeme
SPRING_PROFILES_ACTIVE=prod

# Cashu Vault Service
cashu_vault_port=3333
VAULT_BASE_URL=http://localhost:3333

# HashiCorp Vault
# HashiCorp Vault is the default and only secrets backend
VAULT_BACKEND=hashicorp
VAULT_DEV_ROOT_TOKEN_ID=changeme
VAULT_HASHI_URI=http://hashicorp-vault:8200
VAULT_HASHI_AUTH_METHOD=token
VAULT_HASHI_AUTH_TOKEN=changeme
VAULT_HASHI_AUTH_APPROLE_ROLE_ID=
VAULT_HASHI_AUTH_APPROLE_SECRET_ID=
VAULT_HASHI_ENGINE_MOUNT=cashu

# Vault API credentials (audit C-2, cashu-vault#154). Generate each with: openssl rand -hex 32
# VAULT_API_TOKEN is the mint's read/write credential and is required.
# VAULT_API_READ_TOKEN is optional and read-only (GET/HEAD); it must differ from VAULT_API_TOKEN.
VAULT_API_TOKEN=
VAULT_API_READ_TOKEN=
